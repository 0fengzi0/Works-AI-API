{
  "name": "works-ai-api-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute DB --local --file=./src/db/schema.sql",
    "db:migrate": "wrangler d1 execute DB --local --file=./src/db/migrations/init.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.25",
    "jose": "^5.10.0",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.15.0"
  }
}
